<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.forge.daily-media</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/brad.wood/Projects/leroy/agent/daily-media-runner.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/brad.wood/Projects/leroy</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/brad.wood</string>
        <key>PATH</key>
        <string>/Users/brad.wood/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/brad.wood/Library/Logs/leroy-daily-media.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/brad.wood/Library/Logs/leroy-daily-media.err</string>
</dict>
</plist>
