{
  "permissions": {
    "allow": [
      "mcp__aianna__*",
      "mcp__a2a__*",
      "mcp__leroy__*",
      "mcp__youtube-transcript__*",
      "WebSearch",
      "WebFetch",
      "Read",
      "Glob",
      "Grep",
      "Write"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Read|Agent",
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:9800/hooks/tool-use",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:9800/hooks/subagent",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:9800/hooks/subagent",
            "async": true
          }
        ]
      }
    ]
  }
}
